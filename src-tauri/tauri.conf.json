{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EFTarkov Buddy",
  "version": "1.0.1",
  "identifier": "com.eftarkov.buddy",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EFTarkov Buddy",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "tarkov_quests_db.json",
      "tarkov_quests.json",
      "tarkov_hideout_db.json"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "installMode": "both"
      }
    }
  }
}